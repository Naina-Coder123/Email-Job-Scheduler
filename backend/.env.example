# ---- Server ----
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ---- Postgres ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public"

# ---- Redis (BullMQ + rate-limit counters) ----
# For a managed provider that hands out a single URL (e.g. Upstash's
# rediss://... free tier), set REDIS_URL and leave the vars below blank.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ---- BullMQ worker tuning ----
# Number of jobs the worker processes in parallel
WORKER_CONCURRENCY=5
# Minimum delay enforced between two email sends starting, in ms (provider throttling)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Default hourly cap per sender if a sender/env override isn't provided
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ---- Ethereal / SMTP ----
# Leave blank to auto-create a fresh Ethereal test account for every sender at seed time
ETHEREAL_USER=
ETHEREAL_PASS=

# ---- Elasticsearch ----
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---- Session tokens issued by our backend after Google verification ----
JWT_SECRET=change-me-in-production

# ---- Google OAuth (login verification) ----
# Same Client ID as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# ---- Slack OAuth (rate-limit alerts) ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must match a Redirect URL configured on the Slack app, pointing at this backend
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ---- Bull Board (queue dashboard) basic-auth ----
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin
